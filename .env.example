# PostgreSQL (Supabase): pooled URL for runtime, direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Telegram bot token from @BotFather. Required in production: it validates Mini App init data.
TELEGRAM_BOT_TOKEN=""
# Random string; Telegram sends it back with every webhook update
TELEGRAM_WEBHOOK_SECRET=""

# Public https URL of this deployment (webhook target and bot buttons)
APP_URL="https://your-app.vercel.app"
MINI_APP_URL="https://your-app.vercel.app"

# Random string; Vercel Cron (and any other scheduler) must send `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=""

# Send Telegram messages when a match is created (requires the bot)
MATCHING_NOTIFICATIONS="false"
