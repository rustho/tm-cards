# PostgreSQL (Supabase): pooled URL for runtime, direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Storage for profile photos (Project Settings → API). The service key is server-only
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Public bucket; created by `pnpm db:migrate-photos` if missing
SUPABASE_STORAGE_BUCKET="profile-photos"

# Telegram bot token from @BotFather. Required in production: it validates Mini App init data.
TELEGRAM_BOT_TOKEN=""
# Random string; Telegram sends it back with every webhook update
TELEGRAM_WEBHOOK_SECRET=""

# Public https URL of this deployment (webhook target and bot buttons)
APP_URL="https://your-app.vercel.app"
MINI_APP_URL="https://your-app.vercel.app"
# Mini App deep link base for referral links (t.me/<bot>/<app short name>); defaults to the bot's main Mini App
TELEGRAM_MINI_APP_LINK="https://t.me/your_bot/app"

# Random string; the caller (manual GitHub Actions workflow now, Vercel Cron later) must send `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=""

# Send Telegram messages when a match is created (requires the bot)
MATCHING_NOTIFICATIONS="false"

# Testing only: force the «Встречи» tab phase (week | feedback | signup, see WEEK_SCHEDULE in config/constants.ts). Leave unset in production
# MEETINGS_PHASE="signup"
