{
  "name": "travelmate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "health:check": "curl -s http://localhost:3000/api/health",
    "db:seed": "tsx prisma/seed.ts",
    "db:cleanup-tags": "tsx prisma/cleanup-legacy-tags.ts",
    "db:migrate-photos": "tsx --env-file=.env.local prisma/migrate-photos-to-storage.ts",
    "db:test-subscription": "tsx --env-file=.env.local prisma/grant-test-subscription.ts",
    "matching:run": "tsx --env-file=.env.local prisma/run-matching.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@tma.js/init-data-node": "^2.0.8",
    "@tma.js/sdk-react": "^3.0.23",
    "@vercel/functions": "^3.9.11",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eruda": "^3.0.1",
    "grammy": "^1.46.0",
    "lucide-react": "^1.52.0",
    "next": "14.2.4",
    "next-intl": "^3.17.6",
    "normalize.css": "^8.0.1",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.54.0",
    "react-swipeable": "^7.0.1",
    "tailwind-merge": "^2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.4",
    "postcss": "^8.4.38",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
